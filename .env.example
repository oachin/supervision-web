# === Havet Supervision — Configuration (sans secrets) ===
# Copier vers .env : cp .env.example .env

DOMAIN=supervision-web-01.havetdigital.app
CERTBOT_EMAIL=admin@havetdigital.app
# IP publique de ce serveur (doit correspondre au DNS A du DOMAIN)
SERVER_IP=91.134.100.218

# URLs production (HTTPS via Nginx)
CORS_ORIGIN=https://supervision-web-01.havetdigital.app
NEXT_PUBLIC_API_URL=https://supervision-web-01.havetdigital.app

# Ports (production : seuls 80/443 exposés via Nginx)
HTTP_PORT=80
HTTPS_PORT=443

# --- Cybersécurité / Web Security Audit (EASM) ---
# Clé partagée Nest ↔ service websec (générer : openssl rand -hex 32)
# WEBSEC_API_KEY=
# Concurrence basse par défaut (évite ban Fail2Ban/CSF sur les hôtes cibles)
# AUDIT_WORKERS=3
# AUDIT_ENGINE_WORKERS=2
# AUDIT_SITE_STAGGER_SEC=0.4
# AUDIT_MIN_CONFIDENCE=confirmed
# NVD_API_KEY=

# --- Développement local (docker compose -f docker-compose.dev.yml up) ---
# FRONTEND_PORT=3000
# BACKEND_PORT=4000
# CORS_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:4000
