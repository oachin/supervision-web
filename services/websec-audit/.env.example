# ---------------------------------------------------------------------------
# Web Security Audit Tool — deployment settings.
# Copy this file to `.env` (same folder as docker-compose.yml) and edit it.
# Docker Compose loads `.env` automatically:  docker compose up -d --build
# Never commit the real `.env` — it holds passwords.
# ---------------------------------------------------------------------------

# --- 1. What to scan -------------------------------------------------------
# The target list lives in config/targets.yaml. Put your ROOT DOMAINS under
# `discover:` and the tool finds the sub-domains/assets by itself.
AUDIT_CONFIG=config/targets.yaml

# --- 2. Database -----------------------------------------------------------
# SQLite (default) is fine for a few dozen sites. For 200+ sites scanned
# continuously, use PostgreSQL — the driver ships with the image, and the
# schema is created automatically on first run.
#
# Managed/self-hosted server:
#   AUDIT_DB_URL=postgresql+psycopg://user:password@db-host:5432/websec_audit
# Or start the bundled one:  docker compose --profile postgres up -d
#   AUDIT_DB_URL=postgresql+psycopg://audit:change-me@db:5432/websec_audit
AUDIT_DB_URL=sqlite:////data/audit.db
# Credentials for the bundled `db` service (only used with --profile postgres).
POSTGRES_USER=audit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=websec_audit

# --- 3. Scan depth ---------------------------------------------------------
# Run the external engines (testssl.sh + nuclei, and ZAP when WITH_ZAP=true).
AUDIT_DEEP=true
# Confirms you hold WRITTEN authorization to test these sites. Enables the port
# scan and nuclei's intrusive templates. Leave empty if you are not authorized.
AUDIT_AUTHORIZED=
# Bundle OWASP ZAP into the image at build time (adds a JRE, ~300 MB).
WITH_ZAP=false

# --- 4. Automatic false-positive reduction ---------------------------------
# confirmed -> keep only actively-verified detections + directly-observed facts
# potential -> also keep precise CPE version matches (drops fuzzy keyword hits)
# empty     -> keep everything
AUDIT_MIN_CONFIDENCE=confirmed
# Cross-check every CVE against OSV and drop the ones OSV says do not affect the
# detected version (distro backports).
AUDIT_VERIFY_BACKPORTS=true

# --- 5. Continuous monitoring ----------------------------------------------
# Fixed daily times (server time), comma-separated HH:MM — or use an interval.
AUDIT_SCHEDULE_AT=02:00,14:00
AUDIT_SCHEDULE_MINUTES=0
# Parallelism: "auto" = one worker per site (max 500), or an integer cap.
AUDIT_WORKERS=auto
# Cap the heavy subprocess engines (testssl/nuclei/ZAP) fleet-wide.
AUDIT_ENGINE_WORKERS=4
# Time zone used by the scheduler, e.g. Europe/Paris or Africa/Casablanca.
AUDIT_TZ=Europe/Paris
# Lightweight availability + cert-expiry loop powering the dashboard's "Live
# status" panel, in seconds (0 = disabled), and the browser re-poll interval.
AUDIT_LIVE_INTERVAL=60
AUDIT_LIVE_REFRESH=15
# Bound history growth (both optional, applied after each scan). Without these
# a 24/7 deployment keeps every run forever.
AUDIT_PRUNE_KEEP_RUNS=180
AUDIT_PRUNE_DAYS=365

# --- 6. Dashboard security (required if the dashboard is reachable) --------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Stable cookie-signing key:  openssl rand -hex 32
DASHBOARD_SECRET_KEY=
# Set to 1 ONLY for plain-HTTP LAN use (otherwise cookies are TLS-only).
DASHBOARD_INSECURE_COOKIE=

# --- 7. Email alerts (optional) --------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_FROM=
ALERT_TO=
# A site alerts when its score drops below this (default 60).
ALERT_SCORE_THRESHOLD=60

# --- 8. CVE lookups (optional) ---------------------------------------------
# A free NVD API key raises the CVE lookup rate limit:
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
